---
// 404.astro — shown when a page does not exist.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page could not be found.">
  <section class="section container nf">
    <p class="code">404</p>
    <h1>This page wandered off.</h1>
    <p class="msg">The page you are looking for does not exist or was moved.</p>
    <div class="btn-row">
      <a href="/" class="btn">Back home</a>
      <a href="/work/" class="btn btn--ghost">See my work</a>
    </div>
  </section>
</BaseLayout>

<style>
  .nf { text-align: left; }
  .code { font-family: var(--font-display); font-size: clamp(5rem, 20vw, 14rem); font-weight: 800; line-height: 1; color: var(--color-accent); }
  .nf h1 { margin-block: var(--space-4); }
  .msg { color: var(--color-muted); margin-bottom: var(--space-6); }
</style>

---
// about.astro — photo, bio, skills, tools, CV download.
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
// Replace src/assets/about/portrait.jpg with your real photo (same file name)
import portrait from '../assets/about/portrait.jpg';

// EDIT THESE LISTS
const skills = [
  { name: 'Graphic Design', text: 'Branding, logos, posters and social media visuals.' },
  { name: 'Photography', text: 'Travel, portrait and street photography with natural light.' },
  { name: 'Video Editing', text: 'Short films, promos and colour grading.' },
  { name: 'Sketching', text: 'Pencil and ink illustration, concepts and character studies.' },
];
const tools = ['Photoshop', 'Illustrator', 'InDesign', 'Lightroom', 'Premiere Pro', 'After Effects', 'DaVinci Resolve', 'Figma'];
---

<BaseLayout title="About" description="Muhammad Shahzaib is a computer science student creating graphic design, photography, video editing and sketches.">
  <section class="section container">
    <div class="about">
      <div class="about-photo reveal">
        <Image src={portrait} alt="Portrait of Muhammad Shahzaib" widths={[400, 800]} sizes="(min-width: 800px) 420px, 100vw" />
      </div>
      <div class="reveal">
        <p class="eyebrow">About me</p>
        <h1>Hi, I'm Muhammad Shahzaib.</h1>
        <div class="bio">
          <p>
            I'm a computer science student who spends the rest of my time making things look
            good. I work across graphic design, photography, video editing and sketching, and
            I love how each one teaches me something new about the others.
          </p>
          <p>
            My approach is simple: start with a clear idea, keep the details sharp, and
            make work people remember. Studying code also helps me think about design as a
            system, not just a picture.
          </p>
        </div>
        <a href="/cv.pdf" class="btn" download>Download CV</a>
      </div>
    </div>
  </section>

  <section class="section--tight container reveal" aria-labelledby="skills-title">
    <h2 id="skills-title" class="block-title">What I do</h2>
    <div class="grid">
      {
        skills.map((s) => (
          <div class="skill">
            <h3>{s.name}</h3>
            <p>{s.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section--tight container reveal" aria-labelledby="tools-title">
    <h2 id="tools-title" class="block-title">Tools I use</h2>
    <ul role="list" class="tools">
      {tools.map((t) => <li>{t}</li>)}
    </ul>
  </section>
</BaseLayout>

<style>
  .about { display: grid; gap: var(--space-7); align-items: center; }
  @media (min-width: 800px) { .about { grid-template-columns: 5fr 6fr; gap: var(--space-8); } }
  .about-photo :global(img) { width: 100%; border-radius: var(--radius-lg); aspect-ratio: 4 / 5; object-fit: cover; }
  .about h1 { margin-bottom: var(--space-5); }
  .bio { display: grid; gap: var(--space-4); color: var(--color-muted); margin-bottom: var(--space-6); }

  .block-title { margin-bottom: var(--space-6); }
  .skill {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-6);
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }
  .skill:hover { border-color: var(--color-accent); transform: translateY(-4px); }
  .skill h3 { margin-bottom: var(--space-2); }
  .skill p { color: var(--color-muted); font-size: var(--text-sm); }

  .tools { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .tools li {
    padding: 0.5em 1.1em;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: var(--text-sm);
  }
</style>

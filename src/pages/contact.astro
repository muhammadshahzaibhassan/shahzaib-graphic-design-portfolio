---
// contact.astro — Web3Forms contact form + direct links.
import BaseLayout from '../layouts/BaseLayout.astro';

// ===== REPLACE THESE =====
// Get a free access key at https://web3forms.com (enter your email, key arrives by mail)
const ACCESS_KEY = 'YOUR_WEB3FORMS_ACCESS_KEY_HERE';
const email = 'shahzaib.workmail811@gmail.com';
const socials = [
  { label: 'Behance', href: 'https://www.behance.net/designesbyshahzaib' },
  { label: 'Instagram', href: 'https://www.instagram.com/zaib.psd/' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/muhammad-shahzaib-07ba00425/' },
];
---

<BaseLayout title="Contact" description="Get in touch with Muhammad Shahzaib for design, photography and video projects.">
  <section class="section container">
    <p class="eyebrow">Contact</p>
    <h1 class="title">Let's work together.</h1>

    <div class="layout">
      <form id="contact-form" class="form" novalidate>
        <input type="hidden" name="access_key" value={ACCESS_KEY} />
        <input type="hidden" name="subject" value="New message from your portfolio" />
        <!-- Honeypot: bots fill this, humans never see it -->
        <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" />

        <div class="field">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="6" required></textarea>
        </div>

        <button type="submit" class="btn" id="submit-btn">Send message</button>
        <p id="form-status" class="status" role="status" aria-live="polite"></p>
      </form>

      <aside class="direct">
        <h2>Prefer email?</h2>
        <p><a href={`mailto:${email}`} class="mail">{email}</a></p>
        <h2>Find me online</h2>
        <ul role="list">
          {
            socials.map((s) => (
              <li><a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}<span class="sr-only"> (opens in a new tab)</span></a></li>
            ))
          }
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .title { margin-bottom: var(--space-7); max-width: 14ch; font-size: var(--text-3xl); }
  .layout { display: grid; gap: var(--space-8); }
  @media (min-width: 900px) { .layout { grid-template-columns: 3fr 2fr; } }

  .form { display: grid; gap: var(--space-5); }
  .field { display: grid; gap: var(--space-2); }
  label { font-size: var(--text-sm); font-weight: 500; }
  input[type='text'], input[type='email'], textarea {
    width: 100%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.85em 1em;
    transition: border-color var(--transition-fast);
  }
  input:focus, textarea:focus { border-color: var(--color-accent); outline: none; }
  input:focus-visible, textarea:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .form .btn { justify-self: start; }
  .form .btn[disabled] { opacity: 0.6; cursor: wait; }

  .status { min-height: 1.5em; font-size: var(--text-sm); }
  .status.success { color: #4ade80; }
  .status.error { color: #ff6b6b; }

  .direct h2 { font-size: var(--text-lg); margin-bottom: var(--space-3); }
  .direct ul { display: grid; gap: var(--space-2); margin-bottom: var(--space-6); }
  .direct p { margin-bottom: var(--space-6); }
  .mail { color: var(--color-accent); word-break: break-all; }
</style>

<script>
  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const status = document.getElementById('form-status');
    const btn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    if (!form || !status || !btn) return;

    const show = (msg: string, type: 'success' | 'error') => {
      status.textContent = msg;
      status.className = `status ${type}`;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      btn.disabled = true;
      btn.textContent = 'Sending...';
      status.textContent = '';

      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const data = await res.json();
        if (res.ok && data.success) {
          show('Thank you! Your message was sent. I will reply soon.', 'success');
          form.reset();
        } else {
          show(data.message || 'Something went wrong. Please try again.', 'error');
        }
      } catch {
        show('Network error. Please check your connection or email me directly.', 'error');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Send message';
      }
    });
  }
  document.addEventListener('astro:page-load', initContactForm);
</script>

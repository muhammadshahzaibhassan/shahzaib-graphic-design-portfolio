---
// Lightbox.astro — click any image inside .prose to view it fullscreen.
// Esc or click closes it, left/right arrows move between images.
---

<div class="lightbox" role="dialog" aria-modal="true" aria-label="Image viewer" hidden>
  <button type="button" class="lb-btn lb-close" aria-label="Close image">×</button>
  <button type="button" class="lb-btn lb-prev" aria-label="Previous image">‹</button>
  <img class="lb-img" alt="" />
  <button type="button" class="lb-btn lb-next" aria-label="Next image">›</button>
</div>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 300;
    background: rgb(0 0 0 / 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6);
  }
  .lightbox[hidden] { display: none; }
  .lb-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }
  .lb-btn {
    position: absolute;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.1);
    color: #fff;
    font-size: 1.8rem;
    line-height: 1;
    display: grid;
    place-items: center;
    transition: background var(--transition-fast);
  }
  .lb-btn:hover { background: var(--color-accent); }
  .lb-close { top: var(--space-4); right: var(--space-4); }
  .lb-prev { left: var(--space-4); top: 50%; transform: translateY(-50%); }
  .lb-next { right: var(--space-4); top: 50%; transform: translateY(-50%); }
</style>

<script>
  function initLightbox() {
    const box = document.querySelector<HTMLElement>('.lightbox');
    const bigImg = box?.querySelector<HTMLImageElement>('.lb-img');
    const images = Array.from(document.querySelectorAll<HTMLImageElement>('.prose img'));
    if (!box || !bigImg || !images.length) return;

    let index = 0;
    let lastFocused: HTMLElement | null = null;

    const show = (i: number) => {
      index = (i + images.length) % images.length;
      // Use the largest available source of the optimized image
      bigImg.src = images[index].currentSrc || images[index].src;
      bigImg.alt = images[index].alt;
    };
    const open = (i: number) => {
      lastFocused = document.activeElement as HTMLElement;
      show(i);
      box.hidden = false;
      document.body.style.overflow = 'hidden';
      box.querySelector<HTMLButtonElement>('.lb-close')?.focus();
    };
    const close = () => {
      box.hidden = true;
      document.body.style.overflow = '';
      lastFocused?.focus();
    };

    images.forEach((img, i) => {
      img.tabIndex = 0;
      img.setAttribute('role', 'button');
      img.addEventListener('click', () => open(i));
      img.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          open(i);
        }
      });
    });

    // Click on the dark background closes; buttons have their own actions
    box.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('.lb-prev')) show(index - 1);
      else if (t.closest('.lb-next')) show(index + 1);
      else close();
    });

    document.addEventListener('keydown', (e) => {
      if (box.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
  }
  document.addEventListener('astro:page-load', initLightbox);
</script>

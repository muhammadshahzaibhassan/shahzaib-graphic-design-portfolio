---
// ProjectCard.astro — one clickable card for a project.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, category, year, cover, coverAlt } = project.data;
---

<!-- data-category is read by CategoryFilter.astro -->
<article class="card" data-category={category}>
  <a href={`/work/${project.id}/`} class="card-link">
    <div class="card-media">
      <Image
        src={cover}
        alt={coverAlt}
        widths={[400, 800, 1200]}
        sizes="(min-width: 1000px) 380px, (min-width: 640px) 50vw, 100vw"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="card-body">
      <h3 class="card-title">{title}</h3>
      <p class="card-meta">{category} · {year}</p>
    </div>
  </a>
</article>

<style>
  .card {
    transition: opacity var(--transition), transform var(--transition);
  }
  .card-link { display: block; }
  .card-link:hover { color: inherit; }

  /* Fixed aspect ratio so all cards line up */
  .card-media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-surface);
  }
  .card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  .card-link:hover .card-media :global(img),
  .card-link:focus-visible .card-media :global(img) { transform: scale(1.06); }

  .card-body { padding-top: var(--space-4); }
  .card-title {
    display: inline;
    /* accent underline that grows on hover */
    background: linear-gradient(var(--color-accent), var(--color-accent)) no-repeat 0 100% / 0 2px;
    transition: background-size var(--transition), color var(--transition-fast);
    padding-bottom: 2px;
  }
  .card-link:hover .card-title,
  .card-link:focus-visible .card-title { background-size: 100% 2px; }
  .card-body { transition: transform var(--transition-fast); }
  .card-link:hover .card-body { transform: translateX(6px); }
  .card-meta { color: var(--color-muted); font-size: var(--text-sm); margin-top: var(--space-2); }

  /* States used by the filter script */
  .card.is-hiding { opacity: 0; transform: scale(0.94); }
  .card.is-hidden { display: none; }
</style>
